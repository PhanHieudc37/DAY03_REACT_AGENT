%% ═══════════════════════════════════════════════════════════════════
%% Hybrid Decision Flowchart — Trợ Lý Sàng Lọc CV & Hẹn Phỏng Vấn
%% Role 5: Observability & Trace Analyst
%% Phân luồng: Chatbot Path vs ReAct Agent Path
%% ═══════════════════════════════════════════════════════════════════

flowchart TD
    %% ── ENTRY POINT ──
    U["👤 Yêu cầu từ HR / Người dùng"]
    U --> CLASSIFY{"🔀 Phân loại yêu cầu:<br/>Cần tra cứu dữ liệu, tính toán,<br/>hoặc thao tác hệ thống?"}

    %% ── CHATBOT PATH (Cấp 2) ──
    CLASSIFY -->|"❌ Không — Câu hỏi chính sách /<br/>khái niệm chung"| CB["🤖 Chatbot Baseline Path"]
    CB --> CB_PROC["Trả lời từ kiến thức tĩnh:<br/>• Giải thích chính sách tuyển dụng<br/>• Vai trò của điểm phù hợp<br/>• Quy trình HR"]
    CB_PROC --> CB_OUT["💬 Phản hồi trực tiếp<br/>(0 tool call, latency thấp)"]

    %% ── REACT AGENT PATH (Cấp 3) ──
    CLASSIFY -->|"✅ Có — Cần dữ liệu hệ thống"| RA["🧠 ReAct Agent Path"]
    RA --> PLAN{"📋 Planner phân tích:<br/>Cần tool nào?"}

    %% ── READ-ONLY BRANCH ──
    PLAN -->|"📖 Chỉ đọc dữ liệu"| READ["🔍 Tool Read-Only"]
    READ --> T_GET["get_candidate / get_job<br/>→ Lấy hồ sơ / JD"]
    READ --> T_SCORE["score_candidate<br/>→ Chấm điểm + evidence"]
    READ --> T_RANK["rank_candidates<br/>→ Xếp hạng toàn bộ UV"]
    READ --> T_SLOTS["find_interview_slots<br/>→ Tìm slot còn trống"]

    %% ── WRITE BRANCH (STATE-CHANGING) ──
    PLAN -->|"✏️ Thay đổi trạng thái:<br/>Đặt lịch phỏng vấn"| WRITE["⚠️ Tool Write"]
    WRITE --> HR_CHECK{"🛡️ GUARDRAIL:<br/>HR đã phê duyệt?<br/>(hr_approved = ?)"}
    HR_CHECK -->|"❌ false / chưa duyệt"| BLOCK["🚫 CHẶN:<br/>Trả HR_APPROVAL_REQUIRED<br/>Booking KHÔNG tạo"]
    HR_CHECK -->|"✅ true / đã duyệt"| SLOT_CHECK{"📅 Slot còn trống?"}
    SLOT_CHECK -->|"❌ Không"| SLOT_ERR["🚫 SLOT_UNAVAILABLE"]
    SLOT_CHECK -->|"✅ Có"| BOOK["✅ schedule_interview<br/>→ Đặt lịch mô phỏng<br/>(status: scheduled_demo)"]

    %% ── ERROR HANDLING ──
    PLAN -->|"❓ Tool không tồn tại"| ERR_TOOL["🚫 UNKNOWN_TOOL<br/>Agent dừng an toàn"]
    T_GET --> ID_CHECK{"Ứng viên / JD<br/>tồn tại?"}
    ID_CHECK -->|"❌ Không"| ERR_404["🚫 NOT_FOUND<br/>Agent dừng, không crash"]
    ID_CHECK -->|"✅ Có"| OBS

    %% ── OBSERVATION & OUTPUT ──
    T_SCORE --> OBS["📊 Observation<br/>(dữ liệu có bằng chứng)"]
    T_RANK --> OBS
    T_SLOTS --> OBS
    BOOK --> OBS
    BLOCK --> SAFE_OUT["⚡ Final Answer:<br/>Thông báo lỗi + hướng dẫn"]
    SLOT_ERR --> SAFE_OUT
    ERR_TOOL --> SAFE_OUT
    ERR_404 --> SAFE_OUT

    %% ── GUARDRAIL CHECKS ──
    OBS --> GUARD{"🛡️ GUARDRAILS:<br/>• step ≤ MAX_ITERATIONS?<br/>• Action có lặp không?"}
    GUARD -->|"⚠️ Vi phạm"| SAFE_OUT
    GUARD -->|"✅ An toàn"| FINAL["✅ Final Answer:<br/>Kết quả + evidence<br/>+ nhắc HR quyết định cuối"]

    %% ── STYLING ──
    style U fill:#4A90D9,color:#fff,stroke:#2C5F8A
    style CLASSIFY fill:#F5A623,color:#fff,stroke:#D4891E
    style CB fill:#7B68EE,color:#fff,stroke:#5B48CE
    style CB_PROC fill:#9B8FDB,color:#fff,stroke:#7B68EE
    style CB_OUT fill:#B0A4E3,color:#fff,stroke:#9B8FDB
    style RA fill:#27AE60,color:#fff,stroke:#1E8C4C
    style PLAN fill:#2ECC71,color:#fff,stroke:#27AE60
    style READ fill:#3498DB,color:#fff,stroke:#2980B9
    style WRITE fill:#E67E22,color:#fff,stroke:#D4691E
    style HR_CHECK fill:#E74C3C,color:#fff,stroke:#C0392B
    style BLOCK fill:#C0392B,color:#fff,stroke:#A93226
    style SLOT_CHECK fill:#E74C3C,color:#fff,stroke:#C0392B
    style SLOT_ERR fill:#C0392B,color:#fff,stroke:#A93226
    style BOOK fill:#27AE60,color:#fff,stroke:#1E8C4C
    style GUARD fill:#F39C12,color:#fff,stroke:#E67E22
    style OBS fill:#1ABC9C,color:#fff,stroke:#16A085
    style FINAL fill:#2ECC71,color:#fff,stroke:#27AE60
    style SAFE_OUT fill:#E74C3C,color:#fff,stroke:#C0392B
    style ERR_TOOL fill:#C0392B,color:#fff,stroke:#A93226
    style ERR_404 fill:#C0392B,color:#fff,stroke:#A93226